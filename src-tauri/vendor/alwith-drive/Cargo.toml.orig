[package]
name = "alwith-drive"
description = "ALwith Drive: typed Tauri commands, events and a transactional Rust API, backed by the private native Drive library"
version = "0.6.2"
edition = "2024"
repository = "https://github.com/ALwith-ai/alwith-modules"
license = "MIT OR Apache-2.0"
links = "alwith-drive"
include = ["/Cargo.toml", "/build.rs", "src/**/*.rs", "permissions/**/*", "/LICENSE-MIT", "/LICENSE-APACHE"]
[workspace]

[build-dependencies]
tauri-plugin = { version = "3.0.0-alpha.4", features = ["build"] }

[dependencies]
alwith-native-client = { version = "0.6", path = "../../../crates/native-client" }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
specta = { version = "2.0.0-rc.28", features = ["derive", "function"] }
tauri = { version = "3.0.0-alpha.5", features = ["specta"] }
tauri3-specta = "0.1.0-alpha.5"
tokio = { version = "1", features = ["fs", "rt", "sync"] }

[dev-dependencies]
tokio = { version = "1", features = ["macros", "rt-multi-thread", "time"] }
specta-serde = "0.0.15"
specta-typescript = "0.0.15"
specta-util = "0.0.15"
