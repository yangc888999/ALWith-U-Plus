{
  "$schema": "https://schema.tauri.app/config/3.0.0-alpha.3",
  "productName": "ALWith U⁺",
  "mainBinaryName": "alwith-u",
  "version": "1.3.8",
  "identifier": "ai.alwith.u",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1430",
    "beforeDevCommand": "bun run stage && bun dev",
    "beforeBuildCommand": "bun run stage && bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ALWith U⁺",
        "width": 1280,
        "height": 820,
        "minWidth": 1250,
        "minHeight": 750,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "transparent": true,
        "backgroundThrottling": "disabled",
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/.codex/**"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "alwith-u"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDExRjI1QkRERjA1RDM1NjgKUldSb05WM3czVnZ5RVJ5S0NxZm5HMjZmRHpaK1RudDJRZi9rWFFUdkpXaXdKZW5yQk5yeDdaYU0K",
      "endpoints": [
        "https://github.com/yangc888999/ALWith-U-Plus/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "publisher": "alwith.ai",
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "externalBin": [
      "binaries/alwith-runtime",
      "binaries/bun",
      "binaries/codex",
      "binaries/codex-code-mode-host",
      "binaries/alwith-codex-launcher",
      "binaries/cua-driver"
    ],
    "resources": {
      "resources/adapter": "adapter",
      "resources/computer": "computer",
      "resources/chrome-bridge": "chrome-bridge",
      "resources/licenses": "licenses",
      "resources/native": "native",
      "resources/hakimi": "hakimi",
      "resources/alwith": "alwith",
      "resources/deepseek": "deepseek",
      "resources/qwen": "qwen",
      "resources/openrouter": "openrouter",
      "resources/xai": "xai",
      "resources/kimi": "kimi",
      "resources/zhipu": "zhipu",
      "resources/minimax": "minimax",
      "resources/extensions": "extensions",
      "resources/rob_models": "rob_models",
      "resources/alwith-bridge": "alwith-bridge"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "26.0",
      "entitlements": "./Entitlements.plist"
    }
  }
}
